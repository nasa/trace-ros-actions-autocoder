<%!
    _cpp_types_by_ros_builtins = {
      "bool":       "bool",
      "int8":       "int8_t",
      "uint8":      "uint8_t",
      "int16":      "int16_t",
      "uint16":     "uint16_t",
      "int32":      "int32_t",
      "uint32":     "uint32_t",
      "int64":      "int64_t",
      "uint64":     "uint64_t",
      "float32":    "float",
      "float64":    "double",
      "string":     "std::string"
    }

    def to_cpp_type(ros_builtin_type):
        return _cpp_types_by_ros_builtins[ros_builtin_type]
%>
<%def name="map_result_to_property_map(msg_spec, msg_context, search_path, ns='', depth=0)">
<%
    print('*** ' + msg_spec.full_name + ' ***')
%>
% for f in msg_spec.parsed_fields():
    <%
        depth_var = chr(ord('i') + depth) ## potentially dangerous!
        print('depth_var: ' + depth_var)
        key = '%s.%s'%(ns, f.name) if len(ns) > 0 else f.name
        property_map_key = key
        for index in range(depth):
            d = chr(ord('i') + index)
            property_map_key = property_map_key.replace("[" + d + "]", ".\"+std::to_string(" + d + ")+\"")
        print('property_map_key: ' + property_map_key)
        print('(key, is_array, is_header, is_builtin): (' + key + ', ' + str(f.is_array) + ', ' + str(f.is_header) + ', ' + str(f.is_builtin) + ')')
    %>
    % if (f.is_builtin == True and f.is_array == False):
    ## try {
    % if f.type == 'time':
    properties["${property_map_key}"] = std::to_string(result.${key}.toSec());
    % elif f.type == 'duration':
    properties["${property_map_key}"] = std::to_string(result.${key}.toSec());
    % elif f.type == 'string':
    properties["${property_map_key}"] = result.${key};
    % else:
    properties["${property_map_key}"] = std::to_string(result.${key});
    % endif
    ## } catch (...) {
    ## throw std::out_of_range("Unsupported type in result message.");
    ## }
    % elif f.is_builtin == True and f.is_array == True:
    strings.clear();
    for (std::size_t ${depth_var} = 0; ${depth_var} < result.${key}.size(); ++${depth_var}) {
        ## try {
        % if f.base_type == 'time':
        properties["${property_map_key}." + std::to_string(${depth_var})] = std::to_string(result.${key}[${depth_var}].toSec());
        % elif f.base_type == 'duration':
        properties["${property_map_key}." + std::to_string(${depth_var})] = std::to_string(result.${key}[${depth_var}].toSec());
        % elif f.base_type == 'string':
        properties["${property_map_key}." + std::to_string(${depth_var})] = result.${key}[${depth_var}];
        % else:
        properties["${property_map_key}." + std::to_string(${depth_var})] = std::to_string(result.${key}[${depth_var}]);
        % endif
        strings.push_back(properties["${property_map_key}." + std::to_string(${depth_var})]);
        ## } catch (...) {
        ##     throw std::out_of_range("Unsupported type in result message.");
        ## }
    }
    properties["${property_map_key}"] = trace::ConnectorInterface::vector_to_string(strings);
    % elif f.is_header == False and f.is_array == False:
        <% field_spec = genmsg.msg_loader.load_msg_by_type(msg_context, f.base_type, search_path) %>\
    ${map_result_to_property_map(field_spec, msg_context, search_path, key, depth+1)}\    
    % elif f.is_header == False and f.is_array == True:
    for (std::size_t ${depth_var} = 0; ${depth_var} < result.${key}.size(); ++${depth_var}) {
        <% field_spec = genmsg.msg_loader.load_msg_by_type(msg_context, f.base_type, search_path) %>\
            ${map_result_to_property_map(field_spec, msg_context, search_path, key + '[' + depth_var + ']', depth+1)}\
    }
    % else:
    // unknown key: ${key}
    % endif
%endfor
</%def>
