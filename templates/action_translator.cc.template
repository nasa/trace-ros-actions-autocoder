namespace trace {
namespace ros_msgs_autocoder {

${goal_type} ${action_name}Translator::ToGoal(const PropertyMap& properties) {

    ${goal_type} goal;
    ${print_field_mapping(goal_spec, msg_context, search_path)}
    return goal;
}

PropertyMap ${action_name}Translator::FromResult(const ${result_type} &result) {
    std::vector<std::string> strings;
    PropertyMap properties;
    ${map_result_to_property_map(result_spec, msg_context, search_path)}
    return properties;
}

